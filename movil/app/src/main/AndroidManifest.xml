<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- La app consume la API PHP por red -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- networkSecurityConfig: permite HTTP (sin S) porque XAMPP en local no tiene certificado -->
    <application
        android:name=".AplicacionMaya"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LosHilosDeMaya">

        <!-- Pantalla inicial: inicio de sesión -->
        <activity
            android:name=".vista.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".vista.dashboard.DashboardActivity" />

        <!-- Productos -->
        <activity android:name=".vista.productos.ListaProductosActivity" />
        <activity android:name=".vista.productos.DetalleProductoActivity" />
        <activity android:name=".vista.productos.FormularioProductoActivity" android:windowSoftInputMode="adjustResize" />

        <!-- Clientes -->
        <activity android:name=".vista.clientes.ListaClientesActivity" />
        <activity android:name=".vista.clientes.DetalleClienteActivity" />
        <activity android:name=".vista.clientes.FormularioClienteActivity" android:windowSoftInputMode="adjustResize" />

        <!-- Pedidos -->
        <activity android:name=".vista.pedidos.ListaPedidosActivity" />
        <activity android:name=".vista.pedidos.DetallePedidoActivity" />
        <activity android:name=".vista.pedidos.FormularioPedidoActivity" android:windowSoftInputMode="adjustResize" />

        <!-- Pagos -->
        <activity android:name=".vista.pagos.ListaPagosActivity" />
        <activity android:name=".vista.pagos.DetallePagoActivity" />
        <activity android:name=".vista.pagos.FormularioPagoActivity" android:windowSoftInputMode="adjustResize" />

        <!-- Usuarios -->
        <activity android:name=".vista.usuarios.ListaUsuariosActivity" />
        <activity android:name=".vista.usuarios.DetalleUsuarioActivity" />
        <activity android:name=".vista.usuarios.FormularioUsuarioActivity" android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
