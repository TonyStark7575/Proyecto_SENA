<?xml version="1.0" encoding="utf-8"?>
<!-- No se respalda nada en la nube ni se copia a otro celular: las preferencias guardan la cookie de sesión -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
