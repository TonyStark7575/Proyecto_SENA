<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Maya.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/cargando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Maya.Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Maya.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/campo_correo" />

                    <TextView
                        android:id="@+id/correo"
                        style="@style/Maya.Valor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoLink="email" />

                    <TextView
                        style="@style/Maya.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/campo_telefono" />

                    <TextView
                        android:id="@+id/telefono"
                        style="@style/Maya.Valor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoLink="phone" />

                    <TextView
                        style="@style/Maya.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/registrado_por" />

                    <TextView
                        android:id="@+id/registro"
                        style="@style/Maya.Valor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Maya.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historial_pedidos" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaPedidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-12dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/sinPedidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sin_pedidos"
                android:textColor="@color/texto_suave"
                android:visibility="gone" />

            <TextView
                style="@style/Maya.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historial_pagos" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaPagos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-12dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/sinPagos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sin_pagos"
                android:textColor="@color/texto_suave"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
