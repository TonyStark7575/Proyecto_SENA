# Ruta (URL) donde el servidor web publica la carpeta public/ del proyecto.
# En XAMPP es /ProyectoSENA/public/ . En la nube se cambia solo aquí (por ejemplo a "/").
# De esta ruta salen la API (index.php), las imágenes (img/) y la app compilada (app/).
# No es un secreto: este archivo sí va en Git.
VITE_URL_PUBLIC=/ProyectoSENA/public/
